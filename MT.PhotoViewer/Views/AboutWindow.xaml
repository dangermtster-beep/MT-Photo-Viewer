<Window x:Class="MT.PhotoViewer.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hakkında"
        Height="420" Width="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <!-- Guide §46 — geniş logo banner'ı yalnızca About ekranında kullanılır -->
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Grid.Row="0"
               Source="/Assets/Logo/MT_PhotoViewer_Logo_Banner.png"
               Stretch="Uniform"
               MaxHeight="150"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Fast • Minimal • Professional"
                       HorizontalAlignment="Center"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,10,0,22"/>

            <TextBlock Text="Developed by" HorizontalAlignment="Center"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="Metin TUNÇER" HorizontalAlignment="Center"
                       FontSize="15" FontWeight="SemiBold" Margin="0,2,0,18"/>

            <TextBlock x:Name="VersionText" HorizontalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text=".NET 8 / WPF" HorizontalAlignment="Center"
                       FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Sürüm Notları" Style="{StaticResource MTButton}"
                        Click="ReleaseNotes_Click"/>
                <Button x:Name="CheckUpdatesButton" Content="Güncellemeleri Denetle"
                        Style="{StaticResource MTButton}" Margin="10,0,0,0"
                        Click="CheckUpdates_Click"/>
            </StackPanel>
            <Button Content="Kapat" Style="{StaticResource MTButton}"
                    HorizontalAlignment="Right" IsCancel="True" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
