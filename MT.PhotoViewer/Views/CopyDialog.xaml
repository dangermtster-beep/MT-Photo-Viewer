<Window x:Class="MT.PhotoViewer.Views.CopyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kopya Oluştur"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <!-- Guide §7.2 -->
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Dosya Adı:" Style="{StaticResource MTLabel}" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" x:Name="FileNameBox"/>

        <TextBlock Grid.Row="2" Text="Konum:" Style="{StaticResource MTLabel}" Margin="0,16,0,5"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="FolderBox"/>
            <Button Grid.Column="1" x:Name="BrowseButton" Content="Gözat"
                    Style="{StaticResource MTButton}" Margin="8,0,0,0" MinWidth="78"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button x:Name="CancelButton" Content="İptal" Style="{StaticResource MTButton}" IsCancel="True"/>
            <Button x:Name="SaveButton" Content="Kaydet" Style="{StaticResource MTAccentButton}"
                    Margin="10,0,0,0" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
