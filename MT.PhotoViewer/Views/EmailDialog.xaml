<Window x:Class="MT.PhotoViewer.Views.EmailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="E-posta"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="0,5"/>
        </Style>
    </Window.Resources>

    <!-- Guide §9 -->
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Fotoğraf Boyutu"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,14"/>

        <StackPanel Grid.Row="1">
            <RadioButton x:Name="OriginalOption" Content="Orijinal" IsChecked="True"/>
            <RadioButton x:Name="LargeOption"    Content="Büyük (1920 px)"/>
            <RadioButton x:Name="MediumOption"   Content="Orta (1280 px)"/>
            <RadioButton x:Name="SmallOption"    Content="Küçük (800 px)"/>
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="EstimateText"
                   Margin="0,18,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button x:Name="CancelButton" Content="İptal" Style="{StaticResource MTButton}" IsCancel="True"/>
            <Button x:Name="CreateButton" Content="E-posta Oluştur" Style="{StaticResource MTAccentButton}"
                    Margin="10,0,0,0" MinWidth="128" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
