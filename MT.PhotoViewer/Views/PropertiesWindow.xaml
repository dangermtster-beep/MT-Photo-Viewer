<Window x:Class="MT.PhotoViewer.Views.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MT.PhotoViewer.Views"
        Title="Özellikler"
        Height="560" Width="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <!-- Windows'un özellikler penceresi açılamazsa kullanılan yedek (Guide §7.4) -->
    <views:InfoPanelView x:Name="Panel"/>
</Window>
