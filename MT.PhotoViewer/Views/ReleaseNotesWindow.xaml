<Window x:Class="MT.PhotoViewer.Views.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yenilikler"
        Width="560" Height="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Source="/Assets/Logo/MT_PhotoViewer_Logo.png"
                   Width="40" Height="40" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="SubtitleText" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Sürüm notları -->
        <Border Grid.Row="1"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,14,14">
                <ItemsControl x:Name="NotesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding Changes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="13"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                                           FontSize="13" LineHeight="19"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- İndirme durumu (yalnızca güncelleme modunda) -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="2" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ProgressBar x:Name="DownloadProgress" Height="4" Margin="0,8,0,0"
                         Minimum="0" Maximum="1"/>
        </StackPanel>

        <!-- Düğmeler -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <!-- IsCancel kullanılmaz: indirme sırasında bu düğme pencereyi kapatmadan iptal eder. -->
            <Button x:Name="SecondaryButton" Content="Kapat" Style="{StaticResource MTButton}"
                    Click="SecondaryButton_Click"/>
            <Button x:Name="PrimaryButton" Content="Şimdi Güncelle" Style="{StaticResource MTAccentButton}"
                    Margin="10,0,0,0" IsDefault="True" Visibility="Collapsed"
                    Click="PrimaryButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
