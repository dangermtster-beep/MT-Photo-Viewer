<UserControl x:Class="MT.PhotoViewer.Controls.ZoomableImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True"
             Focusable="False"
             Background="Transparent">

    <!--
        Canvas kullanılır çünkü Grid, çocuğun DesiredSize'ını kullanılabilir alana kırpar;
        bu da büyük görsellerin viewport boyutuna sıkışmasına yol açar. Canvas ise
        çocukları sonsuz alanla ölçer, böylece Width/Height piksel boyutunu korur.
    -->
    <Canvas x:Name="Host" Background="Transparent" ClipToBounds="True">
        <Image x:Name="Img"
               Canvas.Left="0"
               Canvas.Top="0"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="HighQuality"
               UseLayoutRounding="False"
               SnapsToDevicePixels="False">
            <Image.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="Rotate" Angle="0"/>
                    <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="Translate" X="0" Y="0"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
    </Canvas>
</UserControl>
