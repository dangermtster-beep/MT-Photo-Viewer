<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- MT Photo Viewer — Light Theme (Guide §30) -->

    <Color x:Key="WindowBackgroundColor">#FFF5F5F5</Color>
    <Color x:Key="NavbarBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="ToolbarBackgroundColor">#EEFFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#FF181818</Color>
    <Color x:Key="TextSecondaryColor">#FF666666</Color>
    <Color x:Key="BorderColor">#FFD6D6D6</Color>
    <Color x:Key="HoverColor">#FFECECEC</Color>
    <Color x:Key="PressedColor">#FFDCDCDC</Color>
    <Color x:Key="MenuBackgroundColor">#FFFAFAFA</Color>
    <Color x:Key="PanelBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="PhotoBackgroundColor">#FFF2F2F2</Color>
    <Color x:Key="AccentColor">#FF0F7BD4</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush"  Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="NavbarBackgroundBrush"  Color="{StaticResource NavbarBackgroundColor}"/>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="{StaticResource ToolbarBackgroundColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"       Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"     Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="BorderBrushColor"       Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="HoverBrush"             Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="PressedBrush"           Color="{StaticResource PressedColor}"/>
    <SolidColorBrush x:Key="MenuBackgroundBrush"    Color="{StaticResource MenuBackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush"   Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="PhotoBackgroundBrush"   Color="{StaticResource PhotoBackgroundColor}"/>
    <SolidColorBrush x:Key="AccentBrush"            Color="{StaticResource AccentColor}"/>

</ResourceDictionary>
