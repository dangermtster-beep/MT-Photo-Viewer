<Window x:Class="MT.PhotoViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:MT.PhotoViewer.Controls"
        xmlns:views="clr-namespace:MT.PhotoViewer.Views"
        Title="{Binding WindowTitle}"
        Height="800" Width="1280"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        AllowDrop="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Custom title bar + sistem yeniden boyutlandırma davranışı -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Guide §7 — Dosya menüsü -->
        <ContextMenu x:Key="PhotoContextMenu" Style="{StaticResource MTContextMenu}">
            <MenuItem Header="Önceki"          Command="{Binding PreviousCommand}"     InputGestureText="←"/>
            <MenuItem Header="Sonraki"         Command="{Binding NextCommand}"         InputGestureText="→"/>
            <Separator Style="{StaticResource MTMenuSeparator}"/>
            <MenuItem Header="Ekrana Sığdır"   Command="{Binding FitToScreenCommand}"  InputGestureText="Ctrl+0"/>
            <MenuItem Header="Gerçek Boyut"    Command="{Binding ActualSizeCommand}"   InputGestureText="Ctrl+1"/>
            <MenuItem Header="Yakınlaştır"     Command="{Binding ZoomInCommand}"       InputGestureText="+"/>
            <MenuItem Header="Uzaklaştır"      Command="{Binding ZoomOutCommand}"      InputGestureText="-"/>
            <Separator Style="{StaticResource MTMenuSeparator}"/>
            <MenuItem Header="Sola Döndür"     Command="{Binding RotateLeftCommand}"   InputGestureText="Shift+R"/>
            <MenuItem Header="Sağa Döndür"     Command="{Binding RotateRightCommand}"  InputGestureText="R"/>
            <Separator Style="{StaticResource MTMenuSeparator}"/>
            <MenuItem Header="Kopyala"         Command="{Binding CopyCommand}"         InputGestureText="Ctrl+C"/>
            <MenuItem Header="Kopya Oluştur…"  Command="{Binding SaveCopyCommand}"/>
            <MenuItem Header="Farklı Kaydet…"  Command="{Binding SaveAsCommand}"/>
            <Separator Style="{StaticResource MTMenuSeparator}"/>
            <MenuItem Header="Yazdır…"         Command="{Binding PrintCommand}"        InputGestureText="Ctrl+P"/>
            <Separator Style="{StaticResource MTMenuSeparator}"/>
            <MenuItem Header="Dosya Konumunu Aç" Command="{Binding OpenFileLocationCommand}"/>
            <MenuItem Header="Özellikler"      Command="{Binding ShowPropertiesCommand}" InputGestureText="Alt+Enter"/>
            <Separator Style="{StaticResource MTMenuSeparator}"/>
            <MenuItem Header="Sil"             Command="{Binding DeleteCommand}"       InputGestureText="Del"/>
        </ContextMenu>

        <!-- Guide §22 — ⋯ menüsü -->
        <ContextMenu x:Key="MoreMenu" Style="{StaticResource MTContextMenu}" Placement="Top">
            <MenuItem Header="Fotoğrafı Aç…"   Command="{Binding OpenFileCommand}"     InputGestureText="Ctrl+O"/>
            <MenuItem Header="Farklı Kaydet…"  Command="{Binding SaveAsCommand}"/>
            <MenuItem Header="Kopyala"         Command="{Binding CopyCommand}"         InputGestureText="Ctrl+C"/>
            <MenuItem Header="Kopya Oluştur…"  Command="{Binding SaveCopyCommand}"/>
            <Separator Style="{StaticResource MTMenuSeparator}"/>
            <MenuItem Header="Duvar Kağıdı Yap"  Command="{Binding SetWallpaperCommand}"/>
            <MenuItem Header="Dosya Konumunu Aç" Command="{Binding OpenFileLocationCommand}"/>
            <Separator Style="{StaticResource MTMenuSeparator}"/>
            <MenuItem Header="Slayt Gösterisi" Command="{Binding ToggleSlideshowCommand}" InputGestureText="F5"/>
            <MenuItem Header="Fotoğraf Bilgileri" Command="{Binding ToggleInfoPanelCommand}" InputGestureText="I"/>
            <MenuItem Header="Düzenle"         Command="{Binding OpenWithPaintCommand}"/>
            <Separator Style="{StaticResource MTMenuSeparator}"/>
            <MenuItem Header="Yazdır…"         Command="{Binding PrintCommand}"        InputGestureText="Ctrl+P"/>
            <Separator Style="{StaticResource MTMenuSeparator}"/>
            <MenuItem Header="Sil"             Command="{Binding DeleteCommand}"       InputGestureText="Del"/>
            <Separator Style="{StaticResource MTMenuSeparator}"/>
            <MenuItem Header="Ayarlar"         Command="{Binding ShowSettingsCommand}"/>
            <MenuItem Header="Sürüm Notları"   Command="{Binding ShowReleaseNotesCommand}"/>
            <MenuItem Header="Güncellemeleri Denetle" Command="{Binding CheckForUpdatesCommand}"
                      Visibility="{Binding UpdatesConfigured, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="Hakkında"        Command="{Binding ShowAboutCommand}" InputGestureText="F1"/>
        </ContextMenu>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleRow"  Height="34"/>
                <RowDefinition x:Name="NavbarRow" Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════════ 1. Title Bar (Guide §5) ══════════ -->
            <Grid x:Name="TitleBar" Grid.Row="0"
                  Background="{DynamicResource NavbarBackgroundBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image Source="/Assets/Logo/MT_PhotoViewer_Logo.png"
                           Width="24" Height="24"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding WindowTitle}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MTUpdateBadge}"
                            Command="{Binding InstallUpdateCommand}"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                            ToolTip="Yenilikleri gör ve güncelle"
                            Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UpdateBadgeText}" Margin="6,0,0,0"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="{Binding PositionText}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <Button Style="{StaticResource MTCaptionButton}" Content="&#xE921;"
                            Click="Minimize_Click" ToolTip="Simge Durumuna Küçült"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource MTCaptionButton}" Content="&#xE922;"
                            Click="Maximize_Click" ToolTip="Ekranı Kapla"/>
                    <Button Style="{StaticResource MTCloseButton}" Content="&#xE8BB;"
                            Click="Close_Click" ToolTip="Kapat"/>
                </StackPanel>
            </Grid>

            <!-- ══════════ 2. Navbar (Guide §6) ══════════ -->
            <Border x:Name="Navbar" Grid.Row="1"
                    Background="{DynamicResource NavbarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="0,0,0,1">

                <Menu Style="{StaticResource MTMenu}" VerticalAlignment="Center" Margin="6,0,0,0">

                    <MenuItem Header="Dosya">
                        <MenuItem Header="Sil"            Command="{Binding DeleteCommand}"    InputGestureText="Del"/>
                        <MenuItem Header="Kopya Oluştur…" Command="{Binding SaveCopyCommand}"/>
                        <MenuItem Header="Kopyala"        Command="{Binding CopyCommand}"      InputGestureText="Ctrl+C"/>
                        <MenuItem Header="Özellikler"     Command="{Binding ShowPropertiesCommand}" InputGestureText="Alt+Enter"/>
                        <Separator Style="{StaticResource MTMenuSeparator}"/>
                        <MenuItem Header="Çıkış"          Command="{Binding ExitCommand}"/>
                    </MenuItem>

                    <MenuItem Header="Yazdır">
                        <MenuItem Header="Yazdır…"        Command="{Binding PrintCommand}"     InputGestureText="Ctrl+P"/>
                        <MenuItem Header="Hızlı Yazdır"   Command="{Binding QuickPrintCommand}"/>
                        <MenuItem Header="Sayfa Ayarları" Command="{Binding PrintCommand}"/>
                        <MenuItem Header="Yazıcı Ayarları" Click="PrinterSettings_Click"/>
                    </MenuItem>

                    <MenuItem Header="E-posta" Command="{Binding EmailCommand}"/>

                    <MenuItem Header="Yaz">
                        <MenuItem Header="Diske Yaz"           Click="BurnToDisc_Click"/>
                        <MenuItem x:Name="UsbMenu" Header="USB Belleğe Kopyala"
                                  SubmenuOpened="UsbMenu_SubmenuOpened"/>
                        <MenuItem Header="Klasöre Kopyala"     Command="{Binding CopyToFolderCommand}"/>
                    </MenuItem>

                    <MenuItem Header="Aç">
                        <MenuItem Header="Dosya Aç…"   Command="{Binding OpenFileCommand}"   InputGestureText="Ctrl+O"/>
                        <MenuItem Header="Klasör Aç…"  Command="{Binding OpenFolderCommand}"/>
                        <Separator Style="{StaticResource MTMenuSeparator}"/>
                        <MenuItem Header="Paint ile Aç"          Command="{Binding OpenWithPaintCommand}"/>
                        <MenuItem Header="Varsayılan Uygulamayla Aç" Command="{Binding OpenWithDefaultCommand}"/>
                        <MenuItem Header="Uygulama Seç…"         Command="{Binding OpenWithDialogCommand}"/>
                        <Separator Style="{StaticResource MTMenuSeparator}"/>
                        <MenuItem Header="Dosya Konumunu Aç"     Command="{Binding OpenFileLocationCommand}"/>
                    </MenuItem>
                </Menu>
            </Border>

            <!-- ══════════ 3. Fotoğraf alanı (Guide §12) ══════════ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="InfoColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="PhotoArea" Grid.Column="0"
                      Background="{DynamicResource PhotoBackgroundBrush}"
                      ContextMenu="{StaticResource PhotoContextMenu}"
                      MouseMove="PhotoArea_MouseMove">

                    <controls:ZoomableImage x:Name="Viewer"
                                            Source="{Binding CurrentImage}"
                                            PreviewSource="{Binding CurrentPreview}"
                                            Rotation="{Binding Rotation}"
                                            Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"/>

                    <!-- Açılış ekranı (Guide §26) -->
                    <Grid x:Name="Welcome"
                          Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="/Assets/Logo/MT_PhotoViewer_Logo.png"
                                   Width="108" Height="108"
                                   Stretch="Uniform"
                                   Opacity="0.95"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <TextBlock Text="MT PHOTO VIEWER"
                                       HorizontalAlignment="Center"
                                       Margin="0,22,0,0"
                                       FontSize="24"
                                       FontWeight="Light"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <TextBlock Text="Fotoğraflarınızı hızlı, sade ve kaliteli görüntüleyin."
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <Button Content="FOTOĞRAF AÇ"
                                    Command="{Binding OpenFileCommand}"
                                    Style="{StaticResource MTAccentButton}"
                                    HorizontalAlignment="Center"
                                    Margin="0,28,0,0"
                                    Padding="26,10"
                                    FontWeight="SemiBold"/>

                            <TextBlock Text="veya resmi buraya sürükleyin"
                                       HorizontalAlignment="Center"
                                       Margin="0,18,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <TextBlock Text="JPG • PNG • WEBP • BMP • GIF • TIFF"
                                       HorizontalAlignment="Center"
                                       Margin="0,26,0,0"
                                       FontSize="11"
                                       Opacity="0.7"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Önceki / sonraki (Guide §13) -->
                    <Button x:Name="PrevButton"
                            Style="{StaticResource MTNavButton}"
                            Content="&#xE76B;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="18"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0"
                            Command="{Binding PreviousCommand}"
                            ToolTip="Önceki (←)"/>

                    <Button x:Name="NextButton"
                            Style="{StaticResource MTNavButton}"
                            Content="&#xE76C;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="18"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0"
                            Command="{Binding NextCommand}"
                            ToolTip="Sonraki (→)"/>

                    <!-- Yükleme göstergesi (Guide §38) -->
                    <Border Background="#88000000"
                            CornerRadius="10"
                            Width="86" Height="86"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Ellipse Width="34" Height="34"
                                     Stroke="{DynamicResource AccentBrush}"
                                     StrokeThickness="3"
                                     StrokeDashArray="4 3"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Grid>
                    </Border>

                    <!-- Alt floating toolbar (Guide §15) -->
                    <Border x:Name="FloatingToolbar"
                            Style="{StaticResource MTFloatingToolbarBorder}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,26"
                            Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource MTToolbarButton}"
                                    Command="{Binding ZoomOutCommand}"
                                    FontFamily="Segoe MDL2 Assets" FontSize="14"
                                    Content="&#xE71F;" ToolTip="Uzaklaştır (-)"/>

                            <TextBlock Text="{Binding ZoomText}"
                                       Width="54"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <Button Style="{StaticResource MTToolbarButton}"
                                    Command="{Binding ZoomInCommand}"
                                    FontFamily="Segoe MDL2 Assets" FontSize="14"
                                    Content="&#xE8A3;" ToolTip="Yakınlaştır (+)"/>

                            <Rectangle Style="{StaticResource MTToolbarSeparator}"/>

                            <Button Style="{StaticResource MTToolbarButton}"
                                    Command="{Binding FitToScreenCommand}"
                                    FontFamily="Segoe MDL2 Assets" FontSize="14"
                                    Content="&#xE9A6;" ToolTip="Ekrana Sığdır (Ctrl+0)"/>

                            <Button Style="{StaticResource MTToolbarButton}"
                                    Command="{Binding ToggleFullscreenCommand}"
                                    FontFamily="Segoe MDL2 Assets" FontSize="14"
                                    Content="&#xE740;" ToolTip="Tam Ekran (F11)"/>

                            <Rectangle Style="{StaticResource MTToolbarSeparator}"/>

                            <!-- Slayt gösterisi: klasördeki fotoğrafları otomatik sırayla gösterir -->
                            <Button Command="{Binding ToggleSlideshowCommand}"
                                    FontFamily="Segoe MDL2 Assets" FontSize="14">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MTToolbarButton}">
                                        <Setter Property="Content" Value="&#xE768;"/>
                                        <Setter Property="ToolTip" Value="Slayt Gösterisi (F5)"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSlideshowRunning}" Value="True">
                                                <Setter Property="Content" Value="&#xE769;"/>
                                                <Setter Property="ToolTip" Value="Slayt Gösterisini Durdur (F5)"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Rectangle Style="{StaticResource MTToolbarSeparator}"/>

                            <Button Style="{StaticResource MTToolbarButton}"
                                    Command="{Binding RotateLeftCommand}"
                                    ToolTip="Sola Döndür (Shift+R)">
                                <TextBlock Text="&#xE7AD;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform ScaleX="-1"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Button>

                            <Button Style="{StaticResource MTToolbarButton}"
                                    Command="{Binding RotateRightCommand}"
                                    FontFamily="Segoe MDL2 Assets" FontSize="14"
                                    Content="&#xE7AD;" ToolTip="Sağa Döndür (R)"/>

                            <Rectangle Style="{StaticResource MTToolbarSeparator}"/>

                            <Button x:Name="MoreButton"
                                    Style="{StaticResource MTToolbarButton}"
                                    FontFamily="Segoe MDL2 Assets" FontSize="14"
                                    Content="&#xE712;"
                                    Click="MoreButton_Click"
                                    ToolTip="Daha Fazla"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Sağ bilgi paneli (Guide §24) -->
                <views:InfoPanelView x:Name="InfoPanel"
                                     Grid.Column="1"
                                     DataContext="{Binding InfoPanel}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
